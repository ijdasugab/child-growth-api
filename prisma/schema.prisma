generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt    @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash")
  phoneNumber  String?   @map("phone_number") @db.VarChar(30)
  isActive     Boolean?  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  auditLogs        AuditLog[]
  refreshTokens    UserRefreshToken[]
  userChildren     UserChild[]
  userRoles        UserRole[]
  maternalProfiles MaternalProfile[]

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model Role {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  roleId    BigInt    @map("role_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "uq_user_role")
  @@index([userId], map: "idx_user_roles_user_id")
  @@map("user_roles")
}

model UserChild {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  childId   BigInt    @map("child_id")
  relation  String?   @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, childId], map: "uq_user_child")
  @@index([childId], map: "idx_user_children_child_id")
  @@index([userId], map: "idx_user_children_user_id")
  @@map("user_children")
}

model UserRefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  refreshToken String    @map("refresh_token")
  expiredAt    DateTime  @map("expired_at") @db.Timestamp(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P1-5: tanpa index, pencarian token saat refresh memindai seluruh tabel.
  @@index([refreshToken], map: "idx_refresh_tokens_token")
  @@index([userId, revokedAt], map: "idx_refresh_tokens_user_active")
  @@map("user_refresh_tokens")
}

model AuditLog {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt?   @map("user_id")
  action    String    @db.VarChar(50)
  tableName String?   @map("table_name") @db.VarChar(100)
  recordId  BigInt?   @map("record_id")
  oldData   Json?     @map("old_data")
  newData   Json?     @map("new_data")
  ipAddress String?   @map("ip_address") @db.VarChar(100)
  userAgent String?   @map("user_agent")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([tableName, recordId], map: "idx_audit_logs_table_record")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@map("audit_logs")
}

model Child {
  id            BigInt    @id @default(autoincrement())
  fullName      String    @map("full_name") @db.VarChar(100)
  gender        String    @db.VarChar(10)
  birthDate     DateTime  @map("birth_date") @db.Date
  birthWeightKg Decimal?  @map("birth_weight_kg") @db.Decimal(5, 2)
  birthLengthCm Decimal?  @map("birth_length_cm") @db.Decimal(5, 2)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy     BigInt?   @map("created_by")
  updatedBy     BigInt?   @map("updated_by")

  immunizations ChildImmunization[]
  measurements  ChildMeasurement[]
  milestones    ChildMilestone[]
  reminders     Reminder[]
  userChildren  UserChild[]

  @@map("children")
}

model ChildMeasurement {
  id                      BigInt    @id @default(autoincrement())
  childId                 BigInt    @map("child_id")
  measuredAt              DateTime  @map("measured_at") @db.Date
  weightKg                Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  heightCm                Decimal?  @map("height_cm") @db.Decimal(5, 2)
  headCircumferenceCm     Decimal?  @map("head_circumference_cm") @db.Decimal(5, 2)
  notes                   String?
  ageInDays               Int?      @map("age_in_days")
  // P1-1 + P1-2: status diturunkan dari z-score di server, dan nilai z ikut
  // disimpan supaya bisa dihitung ulang saat tabel acuan diperbarui.
  weightForAgeZ           Decimal?  @map("weight_for_age_z") @db.Decimal(4, 2)
  heightForAgeZ           Decimal?  @map("height_for_age_z") @db.Decimal(4, 2)
  weightForHeightZ        Decimal?  @map("weight_for_height_z") @db.Decimal(4, 2)
  headCircumferenceZ      Decimal?  @map("head_circumference_z") @db.Decimal(4, 2)
  weightForAgeStatus      String?   @map("weight_for_age_status") @db.VarChar(50)
  heightForAgeStatus      String?   @map("height_for_age_status") @db.VarChar(50)
  weightForHeightStatus   String?   @map("weight_for_height_status") @db.VarChar(50)
  headCircumferenceStatus String?   @map("head_circumference_status") @db.VarChar(50)
  armCircumferenceCm      Decimal?  @map("arm_circumference_cm") @db.Decimal(5, 2)
  armCircumferenceStatus  String?   @map("arm_circumference_status") @db.VarChar(50)
  growthTrend             String?   @map("growth_trend") @db.VarChar(10)
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy               BigInt?   @map("created_by")
  updatedBy               BigInt?   @map("updated_by")
  updatedAt               DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  child Child @relation(fields: [childId], references: [id])

  @@unique([childId, measuredAt], map: "uq_child_measurement_date")
  @@index([childId], map: "idx_child_measurements_child_id")
  @@index([measuredAt], map: "idx_child_measurements_measured_at")
  @@map("child_measurements")
}

model ChildImmunization {
  id                   BigInt    @id @default(autoincrement())
  childId              BigInt    @map("child_id")
  immunizationMasterId BigInt?   @map("immunization_master_id")
  givenDate            DateTime? @map("given_date") @db.Date
  location             String?   @db.VarChar(150)
  batchNumber          String?   @map("batch_number") @db.VarChar(100)
  administeredBy       String?   @map("administered_by") @db.VarChar(100)
  notes                String?
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy            BigInt?   @map("created_by")
  updatedBy            BigInt?   @map("updated_by")
  updatedAt            DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  child              Child               @relation(fields: [childId], references: [id])
  immunizationMaster ImmunizationMaster? @relation(fields: [immunizationMasterId], references: [id])

  @@map("child_immunizations")
}

model ChildMilestone {
  id                BigInt    @id @default(autoincrement())
  childId           BigInt    @map("child_id")
  milestoneMasterId BigInt    @map("milestone_master_id")
  achieved          Boolean?  @default(false)
  achievedDate      DateTime? @map("achieved_date") @db.Date
  notes             String?
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy         BigInt?   @map("created_by")
  updatedBy         BigInt?   @map("updated_by")
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  child           Child           @relation(fields: [childId], references: [id])
  milestoneMaster MilestoneMaster @relation(fields: [milestoneMasterId], references: [id])

  // P1-3: satu milestone hanya boleh tercatat sekali per anak.
  @@unique([childId, milestoneMasterId], map: "uq_child_milestone")
  @@map("child_milestones")
}

model GrowthStandardType {
  id   BigInt @id @default(autoincrement())
  code String @unique @db.VarChar(30)
  name String @db.VarChar(100)

  standards   GrowthStandard[]
  statusRules GrowthStatusRule[]

  @@map("growth_standard_types")
}

model GrowthStandard {
  id             BigInt    @id @default(autoincrement())
  standardTypeId BigInt    @map("standard_type_id")
  gender         String    @db.VarChar(10)
  ageInDays      Int?      @map("age_in_days")
  heightCm       Decimal?  @map("height_cm") @db.Decimal(5, 2)
  sdMinus3       Decimal?  @map("sd_minus_3") @db.Decimal(7, 3)
  sdMinus2       Decimal?  @map("sd_minus_2") @db.Decimal(7, 3)
  sdMinus1       Decimal?  @map("sd_minus_1") @db.Decimal(7, 3)
  median         Decimal?  @db.Decimal(7, 3)
  sdPlus1        Decimal?  @map("sd_plus_1") @db.Decimal(7, 3)
  sdPlus2        Decimal?  @map("sd_plus_2") @db.Decimal(7, 3)
  sdPlus3        Decimal?  @map("sd_plus_3") @db.Decimal(7, 3)
  // P1-2: parameter LMS WHO. Kalau terisi, z dihitung eksak; kalau kosong,
  // perhitungan jatuh ke interpolasi linear antar titik SD (pendekatan).
  l              Decimal?  @db.Decimal(10, 6)
  m              Decimal?  @db.Decimal(10, 6)
  s              Decimal?  @db.Decimal(10, 6)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  standardType GrowthStandardType @relation(fields: [standardTypeId], references: [id])

  @@index([standardTypeId, gender, ageInDays], map: "idx_growth_standards_type_gender_age")
  @@index([standardTypeId, gender, heightCm], map: "idx_growth_standards_type_gender_height")
  @@map("growth_standards")
}

model GrowthStatusRule {
  id           BigInt   @id @default(autoincrement())
  standardCode String   @map("standard_code") @db.VarChar(30)
  minZScore    Decimal? @map("min_z_score") @db.Decimal(4, 2)
  maxZScore    Decimal? @map("max_z_score") @db.Decimal(4, 2)
  statusLabel  String   @map("status_label") @db.VarChar(100)
  description  String?
  ageMinMonth  Int?     @default(0) @map("age_min_month")
  ageMaxMonth  Int?     @default(60) @map("age_max_month")

  // P1-4: kode harus benar-benar ada di growth_standard_types.
  standardType GrowthStandardType @relation(fields: [standardCode], references: [code])

  @@index([standardCode, minZScore, maxZScore], map: "idx_status_rules_lookup")
  @@map("growth_status_rules")
}

model ImmunizationMaster {
  id                  BigInt  @id @default(autoincrement())
  vaccineName         String  @map("vaccine_name") @db.VarChar(100)
  recommendedAgeMonth Int?    @map("recommended_age_month")
  description         String?

  childImmunizations ChildImmunization[]

  @@unique([vaccineName, recommendedAgeMonth], map: "uq_immunization_name_age")
  @@map("immunization_master")
}

model MilestoneMaster {
  id            BigInt  @id @default(autoincrement())
  ageMonth      Int     @map("age_month")
  category      String? @db.VarChar(50)
  milestoneText String  @map("milestone_text")

  childMilestones ChildMilestone[]

  @@unique([ageMonth, milestoneText], map: "uq_milestone_age_text")
  @@map("milestone_master")
}

model Reminder {
  id           BigInt    @id @default(autoincrement())
  childId      BigInt    @map("child_id")
  title        String    @db.VarChar(150)
  reminderType String?   @map("reminder_type") @db.VarChar(50)
  reminderDate DateTime  @map("reminder_date") @db.Date
  isDone       Boolean?  @default(false) @map("is_done")
  notes        String?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy    BigInt?   @map("created_by")
  updatedBy    BigInt?   @map("updated_by")
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  child Child @relation(fields: [childId], references: [id])

  @@index([childId, reminderDate], map: "idx_reminders_child_date")
  @@map("reminders")
}

// =============================================================================
// PILAR IBU (MATERNAL HEALTH) - BUKU KIA 2024
// =============================================================================

model MaternalProfile {
  id                   BigInt    @id @default(autoincrement())
  userId               BigInt    @map("user_id")
  motherName           String    @map("mother_name") @db.VarChar(100)
  hphtDate             DateTime? @map("hpht_date") @db.Date
  estimatedDueDate     DateTime? @map("estimated_due_date") @db.Date
  prePregnancyWeightKg Decimal?  @map("pre_pregnancy_weight_kg") @db.Decimal(5, 2)
  heightCm             Decimal?  @map("height_cm") @db.Decimal(5, 2)
  gravida              Int?      @default(1)
  para                 Int?      @default(0)
  abortus              Int?      @default(0)
  status               String?   @default("ACTIVE") @db.VarChar(30)
  notes                String?
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ancVisits  AncVisit[]
  ttdLogs    MaternalTtdLog[]
  birthPlans BirthPlan[]

  @@index([userId], map: "idx_maternal_profiles_user_id")
  @@map("maternal_profiles")
}

model AncVisit {
  id                  BigInt    @id @default(autoincrement())
  maternalProfileId   BigInt    @map("maternal_profile_id")
  visitNumber         Int       @map("visit_number")
  trimester           Int       @map("trimester")
  visitDate           DateTime? @map("visit_date") @db.Date
  gestationalAgeWeeks Int?      @map("gestational_age_weeks")
  weightKg            Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  bloodPressure       String?   @map("blood_pressure") @db.VarChar(30)
  fundalHeightCm      Decimal?  @map("fundal_height_cm") @db.Decimal(5, 2)
  fetalHeartRateBpm   Int?      @map("fetal_heart_rate_bpm")
  hemoglobin          Decimal?  @map("hemoglobin") @db.Decimal(4, 1)
  location            String?   @db.VarChar(150)
  examinerName        String?   @map("examiner_name") @db.VarChar(100)
  notes               String?
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  maternalProfile MaternalProfile @relation(fields: [maternalProfileId], references: [id], onDelete: Cascade)

  @@unique([maternalProfileId, visitNumber], map: "uq_anc_visit_number")
  @@map("anc_visits")
}

model MaternalTtdLog {
  id                BigInt    @id @default(autoincrement())
  maternalProfileId BigInt    @map("maternal_profile_id")
  takenDate         DateTime  @map("taken_date") @db.Date
  pillsTaken        Int       @default(1) @map("pills_taken")
  notes             String?
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  maternalProfile MaternalProfile @relation(fields: [maternalProfileId], references: [id], onDelete: Cascade)

  @@unique([maternalProfileId, takenDate], map: "uq_maternal_ttd_date")
  @@map("maternal_ttd_logs")
}

model BirthPlan {
  id                  BigInt    @id @default(autoincrement())
  maternalProfileId   BigInt    @map("maternal_profile_id")
  birthAttendant      String?   @map("birth_attendant") @db.VarChar(100)
  facilityName        String?   @map("facility_name") @db.VarChar(150)
  companionName       String?   @map("companion_name") @db.VarChar(100)
  emergencyTransport  String?   @map("emergency_transport") @db.VarChar(150)
  bloodDonors         String?   @map("blood_donors") @db.VarChar(255)
  chosenContraception String?   @map("chosen_contraception") @db.VarChar(100)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  maternalProfile MaternalProfile @relation(fields: [maternalProfileId], references: [id], onDelete: Cascade)

  @@map("birth_plans")
}
